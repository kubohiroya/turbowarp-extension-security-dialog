{
  "name": "@kubohiroya/turbowarp-extension-security-dialog",
  "version": "0.15.0",
  "description": "Batch extension security review, previews and per-project defaults for TurboWarp hosts",
  "type": "module",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-security-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-extension-security-dialog/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./turbowarp": {
      "types": "./dist/turbowarp.d.ts",
      "import": "./dist/turbowarp.mjs",
      "require": "./dist/turbowarp.cjs"
    },
    "./build-info": "./dist/build-info.json",
    "./styles.css": "./styles.css",
    "./webpack4.css": "./webpack4.css",
    "./catalog-library": {
      "types": "./dist/catalog-library.d.ts",
      "import": "./dist/catalog-library.mjs",
      "require": "./dist/catalog-library.cjs"
    },
    "./catalog-library.css": "./src/catalog-library.css",
    "./project-review": {
      "types": "./dist/project-review.d.ts",
      "import": "./dist/project-review.mjs",
      "require": "./dist/project-review.cjs"
    },
    "./project-review-channel": {
      "types": "./dist/project-review-channel.d.ts",
      "import": "./dist/project-review-channel.mjs",
      "require": "./dist/project-review-channel.cjs"
    },
    "./project-review.css": "./src/project-review.css",
    "./permission-ui": {
      "types": "./dist/permission-ui.d.ts",
      "import": "./dist/permission-ui.mjs",
      "require": "./dist/permission-ui.cjs"
    },
    "./load-errors": {
      "types": "./dist/load-errors.d.ts",
      "import": "./dist/load-errors.mjs",
      "require": "./dist/load-errors.cjs"
    }
  },
  "files": [
    "dist",
    "react.js",
    "turbowarp.js",
    "styles.css",
    "webpack4.css",
    "README.md",
    "README.ja.md",
    "NOTICE.md",
    "LICENSE",
    "src",
    "EDITOR-MIGRATION.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "test": "pnpm run build && node --test test/*.test.cts",
    "check": "pnpm run typecheck && pnpm run test && npm pack --dry-run --ignore-scripts",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.14.0 || ^17 || ^18 || ^19",
    "@kubohiroya/turbowarp-extension-loader": ">=0.11.1 <0.12.0 || 0.12.0 || 0.13.0 || 0.13.1 || 0.15.0 || 0.16.0 || 0.16.1 || 0.16.2",
    "@turbowarp/jszip": ">=3.12.0 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "typescript": "^6.0.3",
    "@kubohiroya/turbowarp-extension-loader": "0.16.2",
    "@turbowarp/jszip": "3.12.0"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-manifest": "0.8.0"
  }
}
