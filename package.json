{
  "name": "@kubohiroya/turbowarp-extension-security-dialog",
  "version": "0.8.8",
  "description": "Batch extension security review, previews and per-project defaults for TurboWarp hosts",
  "type": "module",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-security-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-extension-security-dialog/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./turbowarp": {
      "types": "./dist/turbowarp.d.ts",
      "import": "./dist/turbowarp.mjs",
      "require": "./dist/turbowarp.cjs"
    },
    "./build-info": "./dist/build-info.json",
    "./styles.css": "./styles.css",
    "./webpack4.css": "./webpack4.css"
  },
  "files": [
    "dist",
    "react.js",
    "turbowarp.js",
    "styles.css",
    "webpack4.css",
    "README.md",
    "README.ja.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "test": "pnpm run build && node --test test/*.test.cts",
    "check": "pnpm run typecheck && pnpm run test && npm pack --dry-run --ignore-scripts",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.14.0 || ^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
